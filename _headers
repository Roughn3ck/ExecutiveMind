# Cloudflare Pages _headers for executivemind.io
# Generated: 2026-07-11

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/*.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=3600

/*.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# PDFs are updated by name — a 1-year immutable TTL means a same-name update
# never reaches browsers and needs a Cloudflare purge to land. Cache them for
# an hour instead so PDF revisions ship without manual cache work.
/assets/*.pdf
  Cache-Control: public, max-age=3600, must-revalidate

/articles/*
  Cache-Control: public, max-age=3600
