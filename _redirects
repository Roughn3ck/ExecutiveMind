# Cloudflare Pages redirects for executivemind.io
# Generated: 2026-07-11

# www → apex redirect: handled at Cloudflare zone level (Dynamic Redirect Rule)
# The Pages _redirects full-URL syntax doesn't work for custom domains.
# Zone-level rule: http.host eq "www.executivemind.io" → 301 to https://executivemind.io
# Created: 2026-08-20

# /krisracette and /krisracette.html canonicalize to the bio page
/krisracette /kris-racette-bio 301
/krisracette.html /kris-racette-bio 301

# Cochran marketing page → cochran agent profile
/cochran-legal /cochran 301
/cochran-legal.html /cochran 301

# Trailing-slash normalization
/articles/ /articles 301

# Dead PHP endpoint → Pages Function inquiry endpoint (forms swapped 2026-10-07; POST body preserved)
/agent/send_form.php /api/inquiry 307

# ColdStack removed 2026-10-13 (security incident) — product no longer available.
# 301 not 410: Cloudflare Pages _redirects silently drops 410 status codes
# (verified 2026-11-17 on a preview deployment — the rule parsed but the request
# fell through to the static 404 handler). A 301 to the noindex tombstone is
# the honest, working equivalent: the URL is permanently retired and the
# visitor lands on a page that says so.
/key-manager /gone 301
/key-manager.html /gone 301

# LLM Pricing PDFs — superseded files redirect to the final print PDF.
# The files themselves are removed from assets/; these keep any shared link alive.
/assets/llm-pricing-nov-2026-em-reference.pdf /assets/llm-pricing-nov-2026-em-reference.print.pdf 301
/assets/llm-pricing-nov-2026-em-reference.v3.pdf /assets/llm-pricing-nov-2026-em-reference.print.pdf 301
/assets/llm-pricing-quick-reference-nov-2026.pdf /assets/llm-pricing-nov-2026-em-reference.print.pdf 301
/assets/llm-pricing-quick-reference-nov-2026.print.pdf /assets/llm-pricing-nov-2026-em-reference.print.pdf 301
/assets/llm-pricing-quick-reference-nov-2026.v1.pdf /assets/llm-pricing-nov-2026-em-reference.print.pdf 301

# LLM Pricing — retitled 2026-11-16 to /llm-token-pricing (page moved to root).
# The old paths redirect to the new canonical URL.
# NOTE: there is deliberately NO rule for /llm-token-pricing — the page now
# lives at that path, so a redirect there would hijack it.
/references/llm-token-pricing-november-2026 /llm-token-pricing 301
/references/llm-token-pricing-november-2026.html /llm-token-pricing 301

# Cochran marketing page removed 2026-11-17 — page deleted.
# 301 not 410: see the /key-manager note above — 410 is not supported by
# Cloudflare Pages _redirects and falls through to a bare 404.
/let-the-agents-live /gone 301
/let-the-agents-live.html /gone 301
